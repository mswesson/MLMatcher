# --- Frontend ---
# Порт, на котором доступен веб-интерфейс на хосте.
FRONTEND_PORT=3000

# --- Backend (префикс MLMATCHER_) ---
# Уровень логирования: DEBUG | INFO | WARNING | ERROR
MLMATCHER_LOG_LEVEL=INFO

# Разрешённые CORS-origin'ы через запятую (* — все).
MLMATCHER_CORS_ORIGINS=*

# Лимит размера загружаемого файла (МБ).
MLMATCHER_MAX_UPLOAD_MB=100

# --- Параметры обучения CatBoost ---
MLMATCHER_CATBOOST_ITERATIONS=1000
MLMATCHER_CATBOOST_DEPTH=6
MLMATCHER_CATBOOST_LEARNING_RATE=0.05
# Сколько итераций без улучшения метрики ждать до ранней остановки.
MLMATCHER_CATBOOST_EARLY_STOPPING_ROUNDS=50

# Сколько hard-negative пар генерировать на каждую «Строку 1».
MLMATCHER_NEGATIVES_PER_SAMPLE=4
# Сколько синтетических числовых негативов («та же строка, другая доза») на позитив.
MLMATCHER_NUMERIC_NEGATIVES_PER_SAMPLE=2
# Порог TF-IDF, выше которого негатив считается вероятным дубликатом и отбрасывается.
MLMATCHER_NEGATIVE_DUPLICATE_THRESHOLD=0.92

# Доля выборки под валидацию.
MLMATCHER_VALIDATION_FRACTION=0.2

# Модель эмбеддингов (мультиязычная) для фичи embedding_cosine.
MLMATCHER_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Майнить негативы по эмбеддинг-близости.
MLMATCHER_USE_SEMANTIC_NEGATIVES=true
