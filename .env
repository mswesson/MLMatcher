# --- Frontend ---
# Порт, на котором доступен веб-интерфейс на хосте.
FRONTEND_PORT=3000

# --- Backend (префикс MLMATCHER_) ---
# Уровень логирования: DEBUG | INFO | WARNING | ERROR
MLMATCHER_LOG_LEVEL=INFO

# Разрешённые CORS-origin'ы через запятую (* — все).
MLMATCHER_CORS_ORIGINS=*

# Лимит размера загружаемого файла (МБ).
MLMATCHER_MAX_UPLOAD_MB=100

# --- Параметры обучения CatBoost ---
MLMATCHER_CATBOOST_ITERATIONS=1000
# Глубина 6 (вместо 8): меньше memorization, вероятности не сжаты у порога.
MLMATCHER_CATBOOST_DEPTH=6
MLMATCHER_CATBOOST_LEARNING_RATE=0.05
# L2-регуляризация листьев: глаже модель, устойчивее к поверхностным вариациям.
MLMATCHER_CATBOOST_L2_LEAF_REG=4.0
# Сколько итераций без улучшения метрики ждать до ранней остановки.
MLMATCHER_CATBOOST_EARLY_STOPPING_ROUNDS=50

# Сколько hard-negative пар генерировать на каждую «Строку 1».
# Больше негативов → выше AUC (модель учится на большем числе трудных контрпримеров).
MLMATCHER_NEGATIVES_PER_SAMPLE=3
# Сколько синтетических числовых негативов (та же строка, изменённое число) на позитив.
MLMATCHER_NUMERIC_NEGATIVES_PER_SAMPLE=1
# Сколько аугментированных позитивов (та же пара в иной поверхностной форме) на пару.
# aug=1: добавляет ~4374 позитивов к ~11768 негативам — негативы остаются в большинстве.
# (aug=2 создавало 13122 позитивов vs 11768 негативов → модель всё предсказывала как матч)
MLMATCHER_AUGMENTATIONS_PER_POSITIVE=1
# Порог TF-IDF, выше которого негатив считается вероятным дубликатом и отбрасывается.
MLMATCHER_NEGATIVE_DUPLICATE_THRESHOLD=0.92

# Доля исходных пар под честный hold-out test (оценка качества).
MLMATCHER_TEST_FRACTION=0.3
# Доля train-пула под внутреннюю валидацию (early stopping + калибровка + порог).
MLMATCHER_VALIDATION_FRACTION=0.2
# Метод калибровки вероятностей: sigmoid (Платт) или isotonic.
MLMATCHER_CALIBRATION_METHOD=sigmoid
# Целевой recall верных пар: под него подбирается порог решения.
MLMATCHER_TARGET_RECALL=0.95

# Модель эмбеддингов (мультиязычная) для фичи embedding_cosine.
MLMATCHER_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Майнить негативы по эмбеддинг-близости.
MLMATCHER_USE_SEMANTIC_NEGATIVES=true
